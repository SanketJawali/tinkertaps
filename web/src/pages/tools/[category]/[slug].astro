---
import Footer from '../../../components/Footer.astro';
import Navbar from '../../../components/Navbar.astro';
import OperationUpload from '../../../components/upload/OperationUpload';
import Layout from '../../../layouts/Layout.astro';
import {
	categoryLabel,
	getOperation,
	isOperationCategory,
} from '../../../lib/operations';

const { category, slug } = Astro.params;

const operation =
	category && slug && isOperationCategory(category)
		? getOperation(category, slug)
		: undefined;

if (!operation) {
	return new Response(null, {
		status: 404,
		statusText: 'Not Found',
	});
}

const categoryName = categoryLabel(operation.category);
const isLive =
	operation.status === 'live' && operation.apiOperation !== null;
---

<Layout
	title={`${operation.title} — Tinkertaps`}
	description={operation.description}
	category={operation.category}
>
	<div class="min-h-screen bg-base-100 text-base-content">
		<Navbar />

		<main class="mx-auto max-w-3xl px-5 py-14 lg:px-8 lg:py-18">
			<header>
				<p
					class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary"
				>
					{categoryName}
				</p>

				<h1
					class="mt-4 text-4xl font-semibold tracking-[-0.045em] sm:text-5xl"
				>
					{operation.title}
				</h1>

				<p class="mt-4 max-w-xl text-lg leading-8 text-base-content/55">
					{operation.description}
				</p>
			</header>

			{
				isLive ? (
					<OperationUpload
						client:load
						title={operation.title}
						accept={operation.accept}
						allowedTypes={operation.allowedTypes}
						apiOperation={operation.apiOperation!}
					/>
				) : (
					<section class="mt-10 rounded-box border border-base-300 p-8 sm:p-10">
						<p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary">
							Coming soon
						</p>

						<h2 class="mt-4 text-2xl font-semibold tracking-[-0.035em]">
							This tool is not available yet
						</h2>

						<p class="mt-3 max-w-lg leading-7 text-base-content/55">
							{operation.title} will be available in a later
							release. Try JPEG to PNG in the meantime.
						</p>

						<a
							href="/tools/image/jpeg-to-png"
							class="btn btn-primary mt-8"
						>
							JPEG to PNG
						</a>
					</section>
				)
			}
		</main>

		<Footer />
	</div>
</Layout>
