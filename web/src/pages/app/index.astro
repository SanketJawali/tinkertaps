---
const {
	isAuthenticated,
	redirectToSignIn,
} = Astro.locals.auth();

if (!isAuthenticated) {
	return redirectToSignIn();
}

import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import Layout from '../../layouts/Layout.astro';
import {
	CATEGORIES,
	getCategoryOps,
	toolPath,
} from '../../lib/operations';
---

<Layout
	title="Desk — Tinkertaps"
	description="Open a tool and upload a file."
>
	<div class="min-h-screen bg-base-100 text-base-content">
		<Navbar />

		<main class="mx-auto max-w-6xl px-5 py-14 lg:px-8 lg:py-18">
			<section>
				<p
					class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary"
				>
					Desk
				</p>

				<h1
					class="mt-4 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl"
				>
					Tools
				</h1>

				<p class="mt-3 max-w-xl text-lg leading-8 text-base-content/55">
					Pick a tool, then upload your file.
				</p>
			</section>

			{
				CATEGORIES.map((category) => {
					const ops = getCategoryOps(category.id);

					return (
						<section
							class="mt-14"
							aria-labelledby={`cat-${category.id}`}
						>
							<div
								class="mb-5 flex items-baseline justify-between gap-4"
								data-category={category.id}
							>
								<h2
									id={`cat-${category.id}`}
									class="text-2xl font-semibold tracking-[-0.035em]"
								>
									{category.label}
								</h2>
							</div>

							<div class="grid overflow-hidden rounded-box border border-base-300 sm:grid-cols-2 lg:grid-cols-3">
								{ops.map((op, index) => {
									const borderClass = [
										index % 2 === 0
											? 'sm:border-r'
											: '',
										'border-b border-base-300 last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0 lg:border-r lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-last-child(-n+3)]:border-b-0',
									]
										.filter(Boolean)
										.join(' ');

									if (op.status === 'live') {
										return (
											<a
												href={toolPath(op)}
												class:list={[
													'group flex min-h-44 flex-col justify-between p-6 transition-colors hover:bg-base-200/50',
													borderClass,
												]}
												data-category={category.id}
											>
												<div>
													<p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-primary">
														{category.label}
													</p>

													<h3 class="mt-4 text-xl font-semibold tracking-[-0.03em]">
														{op.title}
													</h3>

													<p class="mt-2 text-sm leading-6 text-base-content/55">
														{op.description}
													</p>
												</div>

												<span
													class="mt-6 text-sm font-medium transition-transform group-hover:translate-x-1"
													aria-hidden="true"
												>
													Open →
												</span>
											</a>
										);
									}

									return (
										<div
											class:list={[
												'flex min-h-44 flex-col justify-between p-6 opacity-60',
												borderClass,
											]}
											data-category={category.id}
										>
											<div>
												<p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-base-content/40">
													{category.label}
												</p>

												<h3 class="mt-4 text-xl font-semibold tracking-[-0.03em] text-base-content/50">
													{op.title}
												</h3>

												<p class="mt-2 text-sm leading-6 text-base-content/40">
													{op.description}
												</p>
											</div>

											<span class="mt-6 font-mono text-[10px] uppercase tracking-[0.12em] text-base-content/35">
												Coming soon
											</span>
										</div>
									);
								})}
							</div>
						</section>
					);
				})
			}
		</main>

		<Footer />
	</div>
</Layout>
