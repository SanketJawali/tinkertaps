---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import Layout from '../layouts/Layout.astro';
import {
	CATEGORIES,
	getCategoryOps,
	toolPath,
} from '../lib/operations';

const liveOps = CATEGORIES.flatMap((category) =>
	getCategoryOps(category.id).filter((op) => op.status === 'live'),
);
---

<Layout
	title="Tinkertaps — File conversion tools"
	description="Convert images, PDFs, and text files. Start with JPEG to PNG."
>
	<div class="min-h-screen bg-base-100 text-base-content">
		<Navbar />

		<main>
			<section
				class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 lg:grid-cols-[1fr_0.9fr] lg:px-8 lg:py-28"
			>
				<div class="max-w-2xl">
					<p
						class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary"
					>
						File tools
					</p>

					<h1
						class="max-w-xl text-5xl font-semibold leading-[0.98] tracking-[-0.045em] sm:text-6xl lg:text-7xl"
					>
						Pick a tool.

						<span class="text-base-content/45">
							Upload a file.
						</span>

						Get the result.
					</h1>

					<p
						class="mt-7 max-w-lg text-lg leading-8 text-base-content/65"
					>
						Image, PDF, and text conversions. Open the tool you
						need, then upload your file.
					</p>

					<div class="mt-9 flex flex-wrap items-center gap-3">
						<a
							href="/tools/image/jpeg-to-png"
							class="btn btn-primary"
						>
							JPEG to PNG
						</a>

						<a
							href="#tools"
							class="btn btn-ghost"
						>
							Browse tools
						</a>
					</div>
				</div>

				<div
					class="file-panel relative mx-auto w-full max-w-lg"
					aria-label="Example conversion"
					data-category="image"
				>
					<div
						class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm"
					>
						<div class="mb-6 flex items-center justify-between">
							<div>
								<p
									class="font-mono text-[11px] uppercase tracking-[0.16em] text-base-content/45"
								>
									Image
								</p>

								<p class="mt-1 font-medium">
									photo.jpg → photo.png
								</p>
							</div>

							<span
								class="badge badge-success badge-soft gap-1.5"
							>
								<span
									class="size-1.5 rounded-full bg-success"
								></span>

								Ready
							</span>
						</div>

						<div class="file-steps">
							<div class="file-step">
								<span class="step-dot"></span>

								<div>
									<p class="font-medium">
										Uploaded
									</p>

									<p class="text-sm text-base-content/45">
										JPEG · 2.4 MB
									</p>
								</div>
							</div>

							<div class="file-step">
								<span class="step-dot"></span>

								<div>
									<p class="font-medium">
										JPEG to PNG
									</p>

									<p class="text-sm text-base-content/45">
										Converting
									</p>
								</div>
							</div>

							<div class="file-step">
								<span class="step-dot"></span>

								<div>
									<p class="font-medium">
										Ready
									</p>

									<p class="text-sm text-base-content/45">
										PNG · 3.1 MB
									</p>
								</div>
							</div>
						</div>

						<div
							class="mt-5 flex items-center justify-between border-t border-base-300 pt-4"
						>
							<p class="text-sm text-base-content/45">
								Result ready
							</p>

							<button
								class="btn btn-primary btn-sm"
								type="button"
							>
								Download
							</button>
						</div>
					</div>
				</div>
			</section>

			<section
				id="tools"
				class="border-y border-base-300 bg-base-200/50"
			>
				<div class="mx-auto max-w-6xl px-5 py-16 lg:px-8">
					<div class="mb-10 max-w-xl">
						<p
							class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary"
						>
							Tools
						</p>

						<h2
							class="mt-3 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl"
						>
							By file type
						</h2>
					</div>

					<div class="grid gap-8 lg:grid-cols-3">
						{
							CATEGORIES.map((category) => {
								const ops = getCategoryOps(category.id);

								return (
									<div
										class="rounded-box border border-base-300 bg-base-100 p-6"
										data-category={category.id}
									>
										<h3 class="text-xl font-semibold tracking-[-0.03em]">
											{category.label}
										</h3>

										<ul class="mt-5 space-y-1">
											{ops.map((op) =>
												op.status === 'live' ? (
													<li>
														<a
															href={toolPath(op)}
															class="flex items-center justify-between rounded-field px-2 py-2.5 text-sm transition-colors hover:bg-base-200"
														>
															<span>{op.title}</span>
															<span class="text-base-content/40">
																→
															</span>
														</a>
													</li>
												) : (
													<li class="flex items-center justify-between px-2 py-2.5 text-sm text-base-content/35">
														<span>{op.title}</span>
														<span class="font-mono text-[10px] uppercase tracking-[0.12em]">
															Soon
														</span>
													</li>
												),
											)}
										</ul>
									</div>
								);
							})
						}
					</div>
				</div>
			</section>

			<section
				id="how-it-works"
				class="mx-auto max-w-6xl px-5 py-16 lg:px-8"
			>
				<div class="mb-10 max-w-xl">
					<p
						class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary"
					>
						How it works
					</p>

					<h2
						class="mt-3 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl"
					>
						Three steps
					</h2>
				</div>

				<div
					class="grid gap-px overflow-hidden rounded-2xl border border-base-300 bg-base-300 md:grid-cols-3"
				>
					<article class="bg-base-100 p-7">
						<p class="font-mono text-xs text-primary">
							01 / TOOL
						</p>

						<h3 class="mt-5 text-xl font-semibold">
							Open a tool
						</h3>

						<p class="mt-3 leading-7 text-base-content/60">
							Choose a conversion such as JPEG to PNG from the
							nav or tool list.
						</p>
					</article>

					<article class="bg-base-100 p-7">
						<p class="font-mono text-xs text-primary">
							02 / UPLOAD
						</p>

						<h3 class="mt-5 text-xl font-semibold">
							Upload your file
						</h3>

						<p class="mt-3 leading-7 text-base-content/60">
							Select a file that matches the tool. Only accepted
							types are allowed.
						</p>
					</article>

					<article class="bg-base-100 p-7">
						<p class="font-mono text-xs text-primary">
							03 / RESULT
						</p>

						<h3 class="mt-5 text-xl font-semibold">
							Download the result
						</h3>

						<p class="mt-3 leading-7 text-base-content/60">
							When the conversion finishes, download the output
							file.
						</p>
					</article>
				</div>
			</section>

			<section class="mx-auto max-w-6xl px-5 pb-16 lg:px-8">
				<div
					class="flex flex-col gap-8 rounded-2xl border border-base-300 bg-base-200/60 p-8 sm:flex-row sm:items-center sm:justify-between lg:p-10"
				>
					<div>
						<h2 class="text-3xl font-semibold tracking-[-0.035em]">
							{liveOps[0]?.title ?? 'JPEG to PNG'}
						</h2>

						<p class="mt-2 text-base-content/60">
							Available now. More tools are on the way.
						</p>
					</div>

					<a
						href="/tools/image/jpeg-to-png"
						class="btn btn-primary shrink-0"
					>
						Open tool
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</div>
</Layout>

<style>
	.file-panel::before {
		content: '';
		position: absolute;
		inset: 18% -6% -8% 25%;
		z-index: -1;
		border-radius: 2rem;

		background: color-mix(
			in oklab,
			var(--color-primary) 7%,
			transparent
		);

		filter: blur(50px);
	}

	.file-steps {
		display: grid;
	}

	.file-step {
		position: relative;
		display: grid;
		grid-template-columns: 1.25rem 1fr;
		gap: 0.875rem;
		min-height: 5rem;
	}

	.file-step:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 1.1rem;
		bottom: -0.1rem;
		left: 0.31rem;
		width: 1px;

		background: color-mix(
			in oklab,
			var(--color-primary) 35%,
			var(--color-base-300)
		);
	}

	.step-dot {
		position: relative;
		z-index: 1;
		margin-top: 0.35rem;
		display: block;
		width: 0.7rem;
		height: 0.7rem;

		border: 2px solid var(--color-base-100);
		border-radius: 999px;

		background: var(--color-primary);

		box-shadow:
			0 0 0 1px var(--color-primary);
	}

	@media (prefers-reduced-motion: no-preference) {
		.file-panel {
			animation: settle-in 500ms ease-out both;
		}

		@keyframes settle-in {
			from {
				opacity: 0;
				transform: translateY(8px);
			}

			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
	}
</style>
